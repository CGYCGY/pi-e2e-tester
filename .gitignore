.pi-e2e-tester/
logs/
state.json
*.log

# Backgrounded app dev output that may leak a copy here
.convex-tmp/

# Editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/

# TypeScript build artifacts (we run noEmit, but just in case)
*.tsbuildinfo
dist/
