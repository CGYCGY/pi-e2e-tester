# Per-app config (secrets + machine-specific paths). Copy configs/example.json.example
# -> configs/<app>.json. Real app files are gitignored; the .example template is tracked.
configs/*.json
!configs/*.example
# Per-app rules markdown is app-specific — gitignored like the config. Copy
# rules/<app>.md.example -> rules/<app>.md. Only the .md.example template is tracked.
rules/*.md

# Dependencies
node_modules/

# Lockfiles are environment-specific here; uncomment to pin if desired.
# bun.lock
# package-lock.json

# Local runtime state & logs
# stateDir lives under ~/.pi-e2e-tester, but ignore any local copies.
.pi-e2e-tester/
logs/
state.json
*.log

# Backgrounded app dev output that may leak a copy here
.convex-tmp/

# Editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/

# TypeScript build artifacts (we run noEmit, but just in case)
*.tsbuildinfo
dist/

# Test workspace: ignore all contents, keep only the dir markers
tests/**
!tests/**/

# Always keep .gitkeep directory markers anywhere
!.gitkeep
