{
  "_README": "TEMPLATE for pi-e2e-tester. Copy this file to `config.json` (which is gitignored) and fill in every CHANGE-ME / <...> placeholder. Keys beginning with `_` are inline docs and are ignored by the loader (shared/config.ts). config.json is the SINGLE source of truth — no paths/ports/tokens/app-or-device specifics are hardcoded anywhere else. Most keys have sane defaults; the ones you MUST set are: token, target.dir, target.androidPackage, device.serial (and device.busid if you use usbipd USB passthrough).",

  "token": "CHANGE-ME-to-a-random-shared-secret",
  "_token_note": "Shared secret checked on every localhost transport request (x-pi4b-token header). Any random string; just keep hub + spokes on the same value. Replace before any non-local use.",

  "stateDir": "~/.pi-e2e-tester",
  "_stateDir_note": "Where persisted runtime state (state.json) is written. `~` expands to $HOME. Logs go under logsDir, not here.",

  "logsDir": "./logs",
  "_logsDir_note": "Where per-role logfiles AND the backgrounded app dev-server logs are written. The hub TAILS these for the real ready signal (auto-readiness) instead of blindly probing ports. Relative paths resolve against the project dir; a leading ~ expands to $HOME.",

  "testsDir": "./tests",
  "_testsDir_note": "Test workspace: holds cases/ (*.md), results/ (*.md), screenshots/ (*.png). The gated LLMs reach the filesystem ONLY here, via the tests_* / read_screenshot tools. Relative paths resolve against the project dir; a leading ~ expands to $HOME.",

  "target": {
    "_about": "The app repo under test. The tester drives it ONLY through the app's own dev tooling (its `just` recipes / scripts) + adb + agent-device; your app repo stays UNTOUCHED. `dir` is the ONE path to change when you move the repo (a startup guard fails loud if it is stale).",
    "dir": "/absolute/path/to/your/app-repo",
    "_dir_note": "Absolute path to your app repo root. On WSL, KEEP it on a Linux-native mount (NOT /mnt/c — that breaks Metro file-watching + Gradle). NOTE: the startup guard currently expects a `justfile` + `apps/mobile` dir at this root (expari-shaped); adjust assertTargetValid in shared/config.ts if your layout differs.",
    "envTest": "/absolute/path/to/your/app/.env.test",
    "_envTest_note": "ABSOLUTE path (decoupled from target.dir) to the test env file holding your test creds. The spoke reads this when it needs to sign in. Leave \"\" if your flow needs no creds file.",
    "androidPackage": "com.yourcompany.yourapp.dev",
    "_androidPackage_note": "The dev build's Android package id, already installed (and ideally logged in) on the test device. The wrong-target guard asserts the foreground app == this; the `app` cold-reset (run-as rm) is GUARDED to this id only. Find it with `adb shell pm list packages | grep <yourapp>`.",
    "crashLogTag": "ReactNativeJS",
    "_crashLogTag_note": "The logcat tag the crash-guard watches and stamps markers under. React-Native apps log under `ReactNativeJS`; a native-Android app or Flutter app uses a different tag (e.g. `flutter`). Used by spoke/device.ts logcat filter + markLog.",
    "crashSignature": "(^|\\s)E[\\/\\s]ReactNativeJS|\\bE ReactNativeJS\\b",
    "_crashSignature_note": "JS RegExp source: a logcat line matching this (case-insensitive) is treated as a crash-error and FAILS the step. The default matches React-Native error lines; set it to your framework's error pattern. A generic fallback (redbox / exception / fatal / unhandled-rejection phrasing) is ALWAYS also applied in code, so you can even leave this loose.",
    "resetPaths": [
      "shared_prefs/SecureStore.xml",
      "files/mmkv/mobile-template",
      "files/mmkv/mobile-template.crc"
    ],
    "_resetPaths_note": "App-private files the `app cold-reset` verb `run-as <androidPackage> rm -f`s (relative to the package's private data dir) to force a true signed-out first run — the auth tokens / user store that survive a force-stop. APP-SPECIFIC: list the files YOUR app persists creds/session in. The defaults shown are an Expo/RN example (SecureStore + an MMKV store). An EMPTY array [] makes cold-reset a plain force-stop. Best-effort per file (a missing path is a no-op).",
    "spokeHints": "Auth: <where the test creds live and how to sign in, e.g. 'creds are in the file at the PI env path envTest; use the read_creds tool to read it when you need to log in'>. <any app-specific gotchas the spoke should know>. Use the app verb's cold-reset for a signed-out first run before testing sign-in.",
    "_spokeHints_note": "APP/AUTH playbook injected verbatim into the spoke LLM's system prompt (alongside the generic verb skeleton + the device's DeviceProfile.submitHint). Put the operational knowledge the spoke CANNOT derive: where creds live, reset semantics, app quirks. Keep DEVICE-input rules (e.g. how to submit a field) OUT of here — those live on the DeviceProfile (device.profile). Empty string ⇒ no app hints."
  },

  "device": {
    "_about": "The physical Android test device. On WSL it is attached via usbipd USB passthrough; on native Linux/macOS adb sees it directly and busid/usbipd are unused.",
    "busid": "<usbipd-busid, e.g. 1-6>",
    "_busid_note": "WSL/usbipd only: the bus id from `usbipd.exe list` (run in Windows). The hub backgrounds `usbipd.exe attach --wsl --busid <busid> --auto-attach` at startup. Ignore on native Linux/macOS.",
    "serial": "CHANGE-ME-adb-serial",
    "_serial_note": "The device's adb serial (from `adb devices`). The spoke pins this on EVERY adb / agent-device call — agent-device also lists a desktop target, so an unpinned call can hit the wrong one. REQUIRED.",
    "usbipd": "usbipd.exe",
    "_usbipd_note": "usbipd binary name or absolute path (WSL only). Default assumes it is on PATH (installs at /mnt/c/Program Files/usbipd-win/usbipd.exe). Ignore on native Linux/macOS.",
    "profile": "samsung-galaxy",
    "_profile_note": "Selects the pluggable DeviceProfile under spoke/profiles/ — vendor input quirks as code, e.g. HOW a focused field is submitted. Built-in: `samsung-galaxy` (submits with Enter and never taps Continue, because Samsung Pass invisibly overlays it) and `pixel-stock` (Enter or a button tap, both fine). For another vendor, add a file in spoke/profiles/ and reference its id here."
  },

  "ports": {
    "_about": "Preferred localhost transport ports. Both AUTO-FALL-BACK to the next free port if occupied, and the resolved values propagate at runtime (hub -> spoke via the HUB_PORT env, spoke -> hub via register). So these are preferences, not guarantees.",
    "hub": 7200,
    "androidSpoke": 7201
  },

  "host": "127.0.0.1",
  "_host_note": "Bind/connect host for all transport servers. Localhost only.",

  "icons": {
    "android": "🤖",
    "web": "🌐",
    "ios": "🍎"
  },
  "_icons_note": "Per-role glyph in the status widget (next to the colored ● dot). Emoji by default; set a role to ASCII (e.g. \"android\": \"AND\") on terminals without emoji/Nerd-Font support. The ● dot color (green=app foreground, amber=device reachable, red=no device) is separate.",

  "hub": {
    "model": "openai-codex/gpt-5.5",
    "thinking": "high",
    "_model_note": "Any model id your pi install is configured for. The hub orchestrates + judges verdicts, so a high reasoning tier is appropriate."
  },

  "android": {
    "_about": "Android spoke model knobs.",
    "model": "openai-codex/gpt-5.5",
    "thinking": "medium",
    "_model_note": "The spoke drives the device mechanically (agent-device + adb), so a medium tier is usually enough."
  },

  "readiness": {
    "_about": "Ready-signal regexes the hub greps out of your backgrounded app dev-server logs for AUTO-READINESS (no manual 'is it up yet?'). Each is a JS RegExp source. The defaults below are for an Expo/Metro + Convex stack — OVERRIDE them to match YOUR dev server's 'ready' log lines. The probe backstops run if a log signal never lands.",
    "convexReady": "Convex functions ready|convex.*ready",
    "_convexReady_note": "RegExp for your BACKEND dev server's 'ready' line (default: Convex). Logged to logsDir. Remove/ignore if you have no backend dev server.",
    "metroReady": "Waiting on http://localhost:8081|Metro waiting|Logs for your project will appear below",
    "_metroReady_note": "RegExp for your BUNDLER/dev server's 'ready' line (default: Expo/Metro on :8081).",
    "usbAttached": "attached",
    "_usbAttached_note": "RegExp hint for the usbipd attach success line (WSL only). The canonical USB check is the adb probe backstop below.",
    "probeAdb": "adb -s {serial} get-state",
    "_probeAdb_note": "PROBE BACKSTOP (device): {serial} is substituted with device.serial; expect output 'device'. Runs if usbAttached never logs.",
    "probeMetro": "http://127.0.0.1:8081/status",
    "_probeMetro_note": "PROBE BACKSTOP (bundler): the hub curls this; Metro answers 'packager-status:running'. Point it at your dev server's health URL, or drop it."
  },

  "defaults": {
    "_about": "Tunable timing defaults shared by hub + spoke (milliseconds).",
    "heartbeatIntervalMs": 5000,
    "_heartbeatIntervalMs_note": "Spoke -> hub heartbeat cadence.",
    "heartbeatTimeoutMs": 15000,
    "_heartbeatTimeoutMs_note": "Hub flips a spoke to disconnected after no heartbeat for this long.",
    "intentTimeoutMs": 180000,
    "_intentTimeoutMs_note": "Budget for a whole intent turn (NL instruction -> spoke drives device -> result). Generous: a device turn may take many actions.",
    "spokeConnectTimeoutMs": 120000,
    "_spokeConnectTimeoutMs_note": "Auto-connect budget for a COLD spoke start (new window + agent-device init).",
    "readyTimeoutMs": 180000,
    "_readyTimeoutMs_note": "How long the hub waits for a dev-up ready signal (log OR probe) before giving up.",
    "readyPollIntervalMs": 2000,
    "_readyPollIntervalMs_note": "Cadence at which the hub re-tails logs / re-runs probes while waiting for ready."
  }
}
